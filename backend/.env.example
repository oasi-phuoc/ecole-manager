# ─── Variables locales (dev) ─────────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

PORT=5000

# Base de données locale (PostgreSQL local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecole_db
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe

# ─── Variables production (Render) ───────────────────────────────────────────
# Sur Render, utiliser DATABASE_URL à la place des DB_* ci-dessus
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Secrets (obligatoires en prod) ──────────────────────────────────────────
JWT_SECRET=une_chaine_aleatoire_longue_et_secrete
SESSION_SECRET=une_autre_chaine_aleatoire

# ─── CORS (optionnel) ────────────────────────────────────────────────────────
# Laisser vide en dev (tous origines acceptées)
# En prod : https://ecole-manager-frontend.onrender.com
CORS_ORIGIN=

# ─── Environnement ───────────────────────────────────────────────────────────
NODE_ENV=development
