# Supabase (obligatoire en prod — plus de Render)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Optionnel : URL des Edge Functions (défaut = SUPABASE_URL/functions/v1)
# REACT_APP_SUPABASE_FUNCTIONS_URL=

# Legacy dev local uniquement (backend Express sur :5000)
# REACT_APP_API_URL=http://localhost:5000/api

# Nombre de pages gardées montées pour navigation fluide (keep-alive)
REACT_APP_KEEP_ALIVE_VIEWS=12
